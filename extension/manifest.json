{
  "manifest_version": 3,
  "name": "VULMS Smart Deadline Tracker",
  "version": "1.0.0",
  "description": "Zero-maintenance automated tracker for Virtual University (VULMS) assignments, quizzes, and GDBs with 12:00 PM email alerts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VULMS Smart Deadline Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.vu.edu.pk/*",
    "*://vulms.vu.edu.pk/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vu.edu.pk/*",
        "*://vulms.vu.edu.pk/*"
      ],
      "all_frames": false,
      "js": [
        "content/extractor.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
